rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Common security helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in [
          'cdacademy992@gmail.com',
          'chinmaykumardash987@gmail.com',
          'admin@cdacademy.com'
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Batches collection - Public educational catalog for all devices & APKs
    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Lectures collection - Video classes visible across all student APKs
    match /lectures/{lectureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Notes collection - Study materials visible across all student APKs
    match /notes/{noteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. DPP collection - Daily practice papers visible across all student APKs
    match /dpp/{dppId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Tests collection - Computer based tests visible across all student APKs
    match /tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Test Results collection
    match /testResults/{resultId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 9. Notifications collection - Instant push announcements for all devices
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Device Notification Tokens collection (FCM)
    match /notificationTokens/{tokenId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 11. Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Materials collection (compatible with comprehensive schema)
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Classes and Subjects configuration
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 14. Audit logs for administration
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // 15. Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email in [
        'cdacademy992@gmail.com',
        'chinmaykumardash987@gmail.com',
        'admin@cdacademy.com'
      ]);
    }
  }
}

