rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in [
          'cdacademy992@gmail.com',
          'chinmaykumardash987@gmail.com',
          'admin@cdacademy.com'
        ])
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin())
        && request.resource.data.role in ['student', 'admin'];
      allow update: if (isOwner(userId) || isAdmin())
        && (isAdmin() || request.resource.data.role == resource.data.role); // Students cannot elevate role
      allow delete: if isAdmin();
    }

    // 2. Batches collection
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Courses collection
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Lectures collection
    match /lectures/{lectureId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Notes collection
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. DPP collection
    match /dpp/{dppId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. Tests collection
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 8. Test Results collection
    match /testResults/{resultId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() || (resource.data.userId == request.auth.uid)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 9. Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
    }

    // 10. Device Notification Tokens collection (FCM)
    match /notificationTokens/{tokenId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 11. Announcements collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 12. Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
